# Banco de dados PostgreSQL (obrigatório)
#
# Desenvolvimento local (npm run dev + só Postgres no Docker):
# DATABASE_URL deve usar localhost e a porta publicada do container (padrão 5433 abaixo).
#
# Stack completa (docker compose up): o compose sobrescreve DATABASE_URL no serviço app
# para postgresql://...@db:5432/... — você pode manter esta linha como localhost para dev local.
DATABASE_URL="postgresql://erp:senha-forte@localhost:5433/erp_espaco_mulher?schema=public"
POSTGRES_USER="erp"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"
POSTGRES_DB="erp_espaco_mulher"

# Opcional: portas publicadas no host (docker-compose.yml)
# POSTGRES_PUBLISH_PORT=5433
# APP_PUBLISH_PORT=3001

# Docker / Prisma: se o volume do Postgres ja tinha tabelas sem _prisma_migrations (erro P3005),
# o entrypoint marca migrações como aplicadas. Para falhar em vez de baseline: PRISMA_AUTO_BASELINE_ON_P3005=0
# PRISMA_AUTO_BASELINE_ON_P3005=1

# JWT — obrigatório em produção. Use uma chave longa e aleatória.
# Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="gere-uma-chave-forte-e-unica"

# Criação do usuário admin (usado por scripts como docker-init / criar-admin)
# ADMIN_EMAIL ou ADMIN_USERNAME é usado como login; ADMIN_PASSWORD como senha.
ADMIN_EMAIL="admin@erp.com"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Opcional: habilita rota de debug de conexão com o banco em produção (não recomendado)
# ENABLE_DB_DEBUG=1

# Ambiente (development | production)
# NODE_ENV=development

# Opcional para migração gradual: permite token legado por header/cookie não-HttpOnly fora de produção.
# ALLOW_LEGACY_TOKEN_FALLBACK=0
